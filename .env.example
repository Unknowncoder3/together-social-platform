PORT=5001
COUPLE_PORT=5002
EXPERIENCE_AI_PORT=5003
JWT_SECRET=change-this-in-local-development

# Local Docker PostgreSQL. If port 5432 is occupied on your Mac,
# map Docker PostgreSQL to 5433 and use localhost:5433 here.
DATABASE_URL=postgresql://together:together_local_password@localhost:5432/together
DB_POOL_MAX=10
DATABASE_SSL=false

# Together's Experience Director is fully local and does not require an AI API key.
# Optional: choose a Python executable when python3 is not the desired environment.
# PYTHON_BIN=python3
